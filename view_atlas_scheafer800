# =========================
# DEFINIZIONE NETWORK/GROUP
# =========================
CORT_ORDER = ["Vis", "SomMot", "DorsAttn", "SalVentAttn", "Limbic", "Cont", "Default"]
SUB_ORDER  = ["HIP", "THA", "PUT", "CAU", "AMY", "NAc", "GP"]
# Alias frequenti (se nei nomi compaiono sigle alternative)
CORT_ALIAS = {
    "DMN": "Default",
    "DAN": "DorsAttn",
    "VAN": "SalVentAttn",
    "FPN": "Cont",
    "SMN": "SomMot",
    # a volte "TempPar" viene usato come subnet; qui lo lascio come Unknown (o mappalo se vuoi)
}

# =========================
# FUNCTIONS
# =========================
def _token_match(s: str, token: str) -> bool:
    """Match token come parola separata da _, spazi o -."""
    return re.search(rf"(?:^|[_\s-]){re.escape(token)}(?:$|[_\s-])", s) is not None

def parse_hemi(roi_name: str) -> str:
    """
    Ritorna 'LH'/'RH' o np.nan.
    Supporta:
      - token 'LH'/'RH' nei nomi corticali (es. 7Networks_LH_Vis_1)
      - suffissi '-lh'/'-rh' nei subcorticali (es. HIP-head-m-lh)
    """
    if roi_name is None or (isinstance(roi_name, float) and np.isnan(roi_name)):
        return np.nan

    s = str(roi_name)

    # caso cortex: token LH/RH
    if _token_match(s, "LH"):
        return "LH"
    if _token_match(s, "RH"):
        return "RH"

    # caso subcortex: suffisso -lh / -rh
    s_low = s.lower()
    if s_low.endswith("-lh") or s_low.endswith("_lh") or s_low.endswith(" lh"):
        return "LH"
    if s_low.endswith("-rh") or s_low.endswith("_rh") or s_low.endswith(" rh"):
        return "RH"

    return np.nan


def parse_cortex_network(roi_name: str) -> str:
    """Ritorna uno dei 7 network corticali o np.nan."""
    if roi_name is None or (isinstance(roi_name, float) and np.isnan(roi_name)):
        return np.nan

    s = str(roi_name)

    # prima i 7 canonici
    for net in CORT_ORDER:
        if _token_match(s, net):
            return net

    # poi alias (DMN, DAN, VAN, ...)
    for alias, mapped in CORT_ALIAS.items():
        if _token_match(s, alias):
            return mapped

    return np.nan


def parse_subcortex_group(roi_name: str) -> str:
    """
    Ritorna una delle 7 strutture subcorticali (HIP/THA/PUT/CAU/AMY/NAc/GP) o np.nan.
    Esempi:
      HIP-head-m-lh -> HIP
      THA-VPm-rh    -> THA
      lAMY-rh       -> AMY
      pGP-lh        -> GP
      NAc-shell-lh  -> NAc
    """
    if roi_name is None or (isinstance(roi_name, float) and np.isnan(roi_name)):
        return np.nan

    s = str(roi_name).replace("_", "-")
    s = re.sub(r"-(lh|rh)$", "", s, flags=re.IGNORECASE)  # togli emisfero finale

    # AMY
    if s.startswith("lAMY") or s.startswith("mAMY"):
        return "AMY"

    # GP
    if s.startswith("pGP") or s.startswith("aGP"):
        return "GP"

    # prefissi standard
    for pref in ("HIP", "THA", "PUT", "CAU", "NAc"):
        if s.startswith(pref + "-") or s == pref:
            return pref

    return np.nan


def parse_roi_name(roi_id: int, roi_name: str):
    """
    Estrae:
      - hemi: LH/RH
      - network: 7 network corticali OPPURE 7 gruppi subcorticali
      - system: 'Cortex'/'Subcortex' (utile per filtri/plot)
    """
    hemi = parse_hemi(roi_name)

    # Se id 801..850 => subcortex (Tian)
    if roi_id is not None and int(roi_id) >= 801:
        g = parse_subcortex_group(roi_name)
        system = "Subcortex" if isinstance(g, str) and g in SUB_ORDER else np.nan
        return dict(hemi=hemi, network=g, system=system)

    # altrimenti cortex (Schaefer)
    g = parse_cortex_network(roi_name)
    system = "Cortex" if isinstance(g, str) and g in CORT_ORDER else np.nan

    # fallback: se non trovato ma sembra subcortex dal naming, prova comunque
    if (g is np.nan) or (isinstance(g, float) and np.isnan(g)):
        g2 = parse_subcortex_group(roi_name)
        if isinstance(g2, str) and g2 in SUB_ORDER:
            return dict(hemi=hemi, network=g2, system="Subcortex")

    return dict(hemi=hemi, network=g, system=system)


def load_lookup_table(lut_xlsx: Path) -> pd.DataFrame:
    if not lut_xlsx.exists():
        raise FileNotFoundError(f"Non trovo LUT: {lut_xlsx}")

    lut = pd.read_excel(lut_xlsx).rename(columns={
        "ROI Label": "roi_id",
        "ROI Name": "roi_name",
        "R/L": "mni_x",
        "A/P": "mni_y",
        "S/I": "mni_z",
    })

    for c in ["roi_id", "roi_name"]:
        if c not in lut.columns:
            raise ValueError(f"Nella LUT manca la colonna '{c}'. Colonne: {list(lut.columns)}")

    lut["roi_id"] = pd.to_numeric(lut["roi_id"], errors="coerce").astype("Int64")
    lut = lut.dropna(subset=["roi_id"]).copy()
    lut["roi_id"] = lut["roi_id"].astype(int)

    # ✅ parsing robusto cortex+subcortex usando anche roi_id
    parsed = lut.apply(lambda r: pd.Series(parse_roi_name(r["roi_id"], r["roi_name"])), axis=1)
    lut = pd.concat([lut, parsed], axis=1)

    # salva lookup
    lut.to_csv(LOOKUP_CSV, index=False)
    lut.to_excel(LOOKUP_XLSX, index=False, engine="openpyxl")
    print(f"[OK] Lookup salvata: {LOOKUP_CSV}")
    print(f"[OK] Lookup Excel salvata: {LOOKUP_XLSX}")

    return lut


def view_atlas_slices(atlas_path: Path, slice_x=None, slice_y=None, slice_z=None):
    if not atlas_path.exists():
        print(f"[SKIP] Atlas non trovato: {atlas_path}")
        return

    img = nib.load(str(atlas_path))
    lab = np.asarray(img.get_fdata(), dtype=np.int32)

    print("\n=== ATLAS INFO ===")
    print("Path:", atlas_path)
    print("Shape:", lab.shape)
    print("Labels min/max:", int(lab.min()), int(lab.max()))
    uniq = np.unique(lab)
    print("N labels (incl 0):", uniq.size)
    print("N labels (excl 0):", (uniq[uniq != 0]).size)

    nx, ny, nz = lab.shape[:3]
    sx = (nx // 2) if slice_x is None else slice_x
    sy = (ny // 2) if slice_y is None else slice_y
    sz = (nz // 2) if slice_z is None else slice_z

    plt.figure(figsize=(12, 4))

    plt.subplot(1, 3, 1)
    plt.imshow(lab[sx, :, :].T, origin="lower", interpolation="nearest")
    plt.title(f"Sagittale (x={sx})")
    plt.axis("off")

    plt.subplot(1, 3, 2)
    plt.imshow(lab[:, sy, :].T, origin="lower", interpolation="nearest")
    plt.title(f"Coronale (y={sy})")
    plt.axis("off")

    plt.subplot(1, 3, 3)
    plt.imshow(lab[:, :, sz].T, origin="lower", interpolation="nearest")
    plt.title(f"Assiale (z={sz})")
    plt.axis("off")

    plt.suptitle("Atlas labels (voxel space)")
    plt.tight_layout()
    plt.show()

    if HAVE_NILEARN:
        print("\n[Nilearn] View interattiva + overlay su MNI152...")
        v = plotting.view_img(img, title="Atlas (labels)")
        v.open_in_browser()

        mni = datasets.load_mni152_template()
        plotting.plot_roi(
            img, bg_img=mni, title="Atlas overlay su MNI152",
            cut_coords=(0, -20, 20), display_mode="ortho", draw_cross=False
        )
        plotting.show()


def save_csv_and_xlsx(df: pd.DataFrame, csv_path: Path, xlsx_name: str):
    csv_path.parent.mkdir(exist_ok=True, parents=True)
    df.to_csv(csv_path, index=False)

    xlsx_path = EXCEL_DIR / xlsx_name
    df.to_excel(xlsx_path, index=False, engine="openpyxl")

    print(f"[SAVE] CSV:  {csv_path}")
    print(f"[SAVE] XLSX: {xlsx_path}")


# =========================
# MAIN 
# =========================
def main():
    print("ROOT =", ROOT)
    print("BASE =", BASE)
    print("OUT  =", OUT)
    print("ATLAS_PATH =", ATLAS_PATH)
    print("TOP_CSV =", TOP_CSV)

    # 1) Visualizza atlas (se vuoi)
    view_atlas_slices(ATLAS_PATH)

    # 2) Carica lookup una sola volta
    lookup = load_lookup_table(LUT_XLSX)

    # 3) Carica top controllers e fai merge
    if not TOP_CSV.exists():
        raise FileNotFoundError(f"Non trovo il file top controllers: {TOP_CSV}")

    top = pd.read_csv(TOP_CSV)

    # Assumo che top abbia almeno: rank, roi_id, node_energy
    for c in ["rank", "roi_id", "node_energy"]:
        if c not in top.columns:
            raise ValueError(f"Nel file {TOP_CSV.name} manca la colonna '{c}'. Colonne: {list(top.columns)}")
    
    top["roi_id"] = pd.to_numeric(top["roi_id"], errors="coerce")
    top = top.dropna(subset=["roi_id"]).copy()
    top["roi_id"] = top["roi_id"].astype(int)

    # Merge + selezione colonne richieste
    top_named = top.merge(
        lookup[["roi_id", "roi_name", "hemi", "network", "system"]],
        on="roi_id",
        how="left"
    )

    # 4) Tabella TOP 43 (campi richiesti)
    top43 = top_named.sort_values("rank").head(43).copy()
    top43 = top43[["rank", "roi_id", "roi_name", "hemi", "network", "system", "node_energy"]]

    print("\n=== TOP 43 CONTROLLERS (named) ===")
    print(top43.to_string(index=False))

    # 5) Tabella separata LH vs RH (sulle 50)
    top43_lh = top43[top43["hemi"] == "LH"].copy()
    top43_rh = top43[top43["hemi"] == "RH"].copy()

    print("\n=== TOP 43 — SOLO LH ===")
    print(top43_lh.to_string(index=False) if len(top43_lh) else "[vuoto]")
    print("\n=== TOP 43 — SOLO RH ===")
    print(top43_rh.to_string(index=False) if len(top43_rh) else "[vuoto]")
    
    # Salva CSV + Excel
    save_csv_and_xlsx(top43, TOP43_CSV,  f"top43_controllers_{BAND}_named.xlsx")
    save_csv_and_xlsx(top43_lh, TOP43_LH_CSV, f"top43_controllers_{BAND}_LH.xlsx")
    save_csv_and_xlsx(top43_rh, TOP43_RH_CSV, f"top43_controllers_{BAND}_RH.xlsx")

    print("\n[EXCEL OUTPUT DIR] =", EXCEL_DIR.resolve())

if __name__ == "__main__":
    main()

